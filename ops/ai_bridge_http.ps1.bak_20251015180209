  if(-not $res2.IsSuccessStatusCode){ Write-Host ('ai-http patch GET FAIL ('+[int]$res2.StatusCode+')'); return }
  $bytes = $res2.Content.ReadAsByteArrayAsync().GetAwaiter().GetResult()
  New-Item -ItemType Directory -Force $InboxDir | Out-Null
  $ppath = Join-Path $InboxDir ('patch_'+$id+'.zip')
  [IO.File]::WriteAllBytes($ppath,$bytes)
  Write-Host ('ai-http patch downloaded -> '+$ppath)
} finally { if($cli2){ $cli2.Dispose() } }

function Invoke-AiPoll {
  param(
    [Parameter(Mandatory=$true)][string]$StatusUrl,
    [int]$MaxPollSeconds = 900,
    [int]$PollIntervalSeconds = 10
  )
  $deadline = (Get-Date).AddSeconds($MaxPollSeconds)
  while ((Get-Date) -lt $deadline) {
    Start-Sleep -Seconds $PollIntervalSeconds
    $r = $cli.GetAsync($StatusUrl).GetAwaiter().GetResult()
    if(-not $r.IsSuccessStatusCode){ throw "poll failed: $([int]$r.StatusCode)" }
    $s = $r.Content.ReadAsStringAsync().Result | ConvertFrom-Json
    if($s.patch_url){ return $s }
    if($s.status -in 'succeeded','failed'){ return $s }
  }
  throw "poll timeout after $MaxPollSeconds sec"
}
