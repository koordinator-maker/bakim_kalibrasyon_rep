function Invoke-AiSubmit {
  param(
    [Parameter(Mandatory=$true)][string]$SubmitUrl,
    [Parameter(Mandatory=$true)][string]$ReqPath,
    [Parameter(Mandatory=$false)][string]$BundlePath,
    [int]$TimeoutMin = 8
  )
  Add-Type -AssemblyName System.Net.Http | Out-Null
  [Net.ServicePointManager]::SecurityProtocol = [Net.SecurityProtocolType]::Tls12
  $result = [ordered]@{ UploadOk=$false; Id=$null; Status=0; Body=''; Error='' }
  if ([string]::IsNullOrWhiteSpace($SubmitUrl) -or -not $SubmitUrl.StartsWith('http')) {
    $result.Error = "AI_ENDPOINT geçersiz: '$SubmitUrl'"
    return [pscustomobject]$result
  }
  $http = New-Object System.Net.Http.HttpClient
  $http.Timeout = [TimeSpan]::FromMinutes($TimeoutMin)
  try {
    # Auth header’lar (Bearer + X-API-Key)
    if ($env:AI_API_KEY) {
      try { $http.DefaultRequestHeaders.Authorization =
              New-Object System.Net.Http.Headers.AuthenticationHeaderValue('Bearer', $env:AI_API_KEY) } catch {}
      try { $http.DefaultRequestHeaders.Remove('X-API-Key') } catch {}
      $http.DefaultRequestHeaders.Add('X-API-Key', $env:AI_API_KEY)
    }
    $mp = New-Object System.Net.Http.MultipartFormDataContent
    # request json
    $requestText = Get-Content -LiteralPath $ReqPath -Raw -Encoding UTF8
    $reqContent = New-Object System.Net.Http.StringContent($requestText,[Text.UTF8Encoding]::new($false),'application/json')
    $mp.Add($reqContent,'request','ai_request.json')
    # bundle (opsiyonel)
    if (-not $BundlePath -or -not (Test-Path $BundlePath)) {
      $b = Get-ChildItem "_otokodlama\bundle" -Filter 'bundle_*.zip' -File -ErrorAction SilentlyContinue |
           Sort-Object LastWriteTime -Desc | Select-Object -First 1
      if ($b) { $BundlePath = $b.FullName }
    }
    $fs = $null; $fileContent = $null
    if ($BundlePath -and (Test-Path $BundlePath)) {
      $fs = [System.IO.File]::Open($BundlePath,[System.IO.FileMode]::Open,[System.IO.FileAccess]::Read,[System.IO.FileShare]::Read)
      $fileContent = New-Object System.Net.Http.StreamContent($fs)
      $fileContent.Headers.ContentType = [System.Net.Http.Headers.MediaTypeHeaderValue]::Parse('application/zip')
      $mp.Add($fileContent,'bundle',[System.IO.Path]::GetFileName($BundlePath))
    } else {
      Write-Host "[ai-http] bundle yok; yalnız 'request' gönderilecek."
    }
    Write-Host "[ai-http] submit → $SubmitUrl"
    $resp  = $http.PostAsync($SubmitUrl,$mp).GetAwaiter().GetResult()
    $body  = $resp.Content.ReadAsStringAsync().GetAwaiter().GetResult()
    $code  = [int]$resp.StatusCode
    $result.Status = $code
    if ($body) {
      $max = [Math]::Min(2000, $body.Length)
      $result.Body = $body.Substring(0,$max)
    }
    if ($resp.IsSuccessStatusCode) {
      $result.UploadOk = $true
      Write-Host "[ai-http] submit OK ($code)"
    } else {
      Write-Host "[ai-http] submit FAIL ($code) body: $($result.Body)"
    }
    # Yanıttan id çıkart
    if ($result.UploadOk -and $result.Body) {
      try {
        $obj = $result.Body | ConvertFrom-Json -ErrorAction SilentlyContinue
        if ($obj) {
          if ($obj.id)          { $result.Id = $obj.id }
          elseif ($obj.request_id){ $result.Id = $obj.request_id }
          elseif ($obj.token)   { $result.Id = $obj.token }
        }
      } catch {}
      if (-not $result.Id -and $resp -and $resp.Headers -and $resp.Headers.Location) {
        $result.Id = $resp.Headers.Location.ToString()
      }
    }
  } catch {
    $result.Error = $_.Exception.Message
    Write-Host "[ai-http] submit EXCEPTION: $($result.Error)"
  } finally {
    if ($fileContent) { $fileContent.Dispose() }
    if ($fs)         { $fs.Dispose() }
    if ($mp)         { $mp.Dispose() }
    if ($http)       { $http.Dispose() }
  }
  return [pscustomobject]$result
}
