const BASE = (process.env.BASE_URL || "http://127.0.0.1:8010").replace(/\/$/, "");
const USER = process.env.ADMIN_USER || "admin";
const PASS = process.env.ADMIN_PASS || "admin123!";

async function loginIfNeeded(page){
  await page.goto(`${BASE}/admin/`, { waitUntil: "domcontentloaded" });
  if (/\/login\//i.test(page.url())) {
    await page.fill('input[name="username"]', USER);
    await page.fill('input[name="password"]', PASS);
    await page.locator('input[type="submit"]').first().click();
    await page.waitForLoadState("domcontentloaded");
  }
  return page;
}

export async function ensureLogin(page){ return loginIfNeeded(page); }

export async function gotoList(page){
  await ensureLogin(page);
  await page.goto(`${BASE}/admin/maintenance/equipment/`, { waitUntil: "domcontentloaded" });
  return page;
}

export async function gotoAdd(page){
  await ensureLogin(page);
  await page.goto(`${BASE}/admin/maintenance/equipment/add/`, { waitUntil: "domcontentloaded" });
  return page;
}

export async function fillAllRequired(page){
  if(!page || page.isClosed()){ 
    console.warn('[SKIP] Page closed');
    return; 
  }
  
  await page.waitForLoadState('domcontentloaded', { timeout: 5000 }).catch(()=>{});
  
  for(const sel of ['#id_code','input[name="code"]','#id_name','input[name="name"]']){
    try{
      const el = page.locator(sel).first();
      const cnt = await el.count().catch(()=>0);
      if(cnt > 0){
        const v = await el.inputValue({ timeout: 2000 }).catch(()=>'');
        if(!v) await el.fill(`AUTO_${Date.now()}`, { timeout: 2000 });
      }
    }catch(e){ console.warn(`Skip ${sel}`); }
  }
  
  try{
    const req = page.locator('input[required]:visible,select[required]:visible');
    const n = await req.count();
    for(let i=0; i<n; i++){
      const el = req.nth(i);
      const tag = await el.evaluate(e=>e.tagName.toLowerCase());
      if(tag==='select'){
        const opts = await el.locator('option[value]:not([value=""])').all();
        if(opts[0]) await el.selectOption(await opts[0].getAttribute('value'));
      }else{
        const cur = await el.inputValue().catch(()=>'');
        if(!cur) await el.fill('auto');
      }
    }
  }catch(e){}
}

export async function save(page){
  await page.locator('input[name="_save"],button[type="submit"]').first().click();
  await page.waitForLoadState("domcontentloaded");
}

export async function createMinimalEquipment(page){
  await gotoAdd(page);
  await page.locator('#id_code,input[name="code"]').first().fill(`C-${Date.now()}`);
  await page.locator('#id_name,input[name="name"]').first().fill(`EQ-${Date.now()}`);
  await fillAllRequired(page);
  await save(page);
  return page;
}

export async function successFlashExists(page){
  return await page.locator('.messagelist .success').count() > 0;
}
